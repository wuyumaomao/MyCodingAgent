# Select the profile used by default: openai or deepseek
CODING_AGENT_PROVIDER=openai

# Provider profiles. Keep both keys here; switch only CODING_AGENT_PROVIDER.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-openai-model
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Backward-compatible generic names (used when the selected profile is unset)
CODING_AGENT_API_KEY=your-api-key
CODING_AGENT_MODEL=your-model
CODING_AGENT_BASE_URL=https://api.openai.com/v1
